rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /planning/{document=**} {
      allow read, write;
    }
    match /retro/{document=**} {
      allow read, write;
    }
    match /retroGroup/{document=**} {
      allow read, write;
    }
    match /invites/{code} {
      // Vertreter-Freigabe-Codes: nur per bekanntem Code lesbar (get) + schreibbar. list bewusst NICHT
      // erlaubt, damit die Codes nicht enumerierbar sind. Achtung: 'read' wuerde 'list' einschliessen
      // (OR-Semantik) -> hier ausdruecklich nur 'get'.
      allow get, write;
    }
    match /user/{document=**} {
      allow read, write;
      allow list: if false;
    }
    match /project/{project} {
      allow create: if request.auth != null;
      allow list: if request.auth != null && (
      	request.auth.uid == resource.data.owner ||
      	request.auth.uid in resource.data.coReaders ||
      	request.auth.uid in resource.data.coWriters
      );
      allow write: if request.auth != null && (
      	request.auth.uid == resource.data.owner ||
      	request.auth.uid in resource.data.coWriters
      );
      allow read: if request.auth != null && (
      	request.auth.uid == resource.data.owner ||
      	request.auth.uid in resource.data.coReaders ||
      	request.auth.uid in resource.data.coWriters
      );
    }
  }
}



